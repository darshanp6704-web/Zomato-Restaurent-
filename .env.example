# Dataset
DATASET_ID=ManikaSaini/zomato-restaurant-recommendation
DATASET_SPLIT=train
REFRESH_DATASET=false

# Budget tiers (INR, calibrated for this dataset)
BUDGET_LOW_MAX=400
BUDGET_MEDIUM_MAX=550

# Filtering (Phase 2)
MAX_CANDIDATES=40
TOP_N=5
LOCATION_MATCH_MODE=contains
INCLUDE_UNKNOWN_COST_IN_BUDGET=false

# Groq LLM (Phase 3+) — https://console.groq.com/keys
# GROQ_API_KEY=
# GROQ_MODEL=llama-3.3-70b-versatile
# GROQ_BASE_URL=  # optional; omit when using official groq SDK (default endpoint is used)
# LLM_TEMPERATURE=0.3

# UI / debug
# DEBUG=false
